graph TD
    A["Sinh viên nhập câu hỏi"] --> B{"Router / Intent Checker"}
    
    %% Nhánh Chatbot
    B -- "Câu hỏi lý thuyết" --> C["LLM Baseline"]
    C --> D["Trả lời trực tiếp bằng kiến thức nền"]
    
    %% Nhánh ReAct Agent
    B -- "Yêu cầu lập kế hoạch" --> E["ReAct Agent Loop"]
    E --> F{"Agent: Thought (Suy luận)"}
    
    F --> |"Cần gọi Tool"| G["Action: Chọn hàm trong AVAILABLE_TOOLS"]
    
    G --> |"get_student_profile"| T1["Lấy hồ sơ & môn đã học"]
    G --> |"search_courses"| T2["Tìm môn trong Catalog"]
    G --> |"check_prerequisites"| T3["Kiểm tra môn tiên quyết"]
    G --> |"check_schedule_conflicts"| T4["Kiểm tra trùng lịch"]
    G --> |"calculate_credit_load"| T5["Kiểm tra 12-18 tín chỉ"]
    G --> |"recommend_course_plan"| T6["Gợi ý kế hoạch mẫu"]
    
    T1 --> O["Observation (Kết quả trả về)"]
    T2 --> O
    T3 --> O
    T4 --> O
    T5 --> O
    T6 --> O
    
    O --> |"Có LỖI / Cần thêm thông tin"| F
    O --> |"Dữ liệu hợp lệ"| F
    
    F --> |"Đã đủ dữ kiện & Qua Guardrails"| M["Final Answer: Tổng hợp kế hoạch"]
    
    D --> Z["Hiển thị cho Sinh viên"]
    M --> Z